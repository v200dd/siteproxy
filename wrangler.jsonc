{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "siteproxy",
    "main": "worker.js",
    "build": {
        "command": "npm run build"
    },
    "compatibility_date": "2026-11-20",
    "compatibility_flags": ["nodejs_compat"],
    "keep_vars": true,
    "observability": {
        "enabled": false
    }
}
