{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "siteproxy",
    "main": "worker.js",
    "build": {
        "command": "npm run build",
        "watch_dir": "./src"
    },
    "compatibility_date": "2025-07-23",
    "compatibility_flags": ["nodejs_compat"],
    "keep_vars": true,
    "observability": {
        "enabled": false
    }
}
